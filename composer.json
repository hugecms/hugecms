{
    "name": "hugecms/hugecms",
    "description": "The new content management system",
    "type": "project",
    "keywords": [
        "hugecms",
        "thinkphp"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "juling/think-foundation": "^1.0",
        "topthink/framework": "^8.0",
        "topthink/think-filesystem": "^3.0",
        "topthink/think-migration": "^3.1",
        "topthink/think-orm": "^4.0",
        "topthink/think-queue": "^3.0",
        "topthink/think-view": "^2.0",
        "topthink/think-worker": "^5.0"
    },
    "require-dev": {
        "juling/think-devtools": "^1.1",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0",
        "zircote/swagger-php": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan service:discover",
            "@php artisan vendor:publish"
        ]
    }
}
