    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
